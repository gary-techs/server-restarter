# E2E API credentials
E2E_API_KEY=your-e2e-api-key
E2E_API_TOKEN=your-e2e-api-token
E2E_PROJECT_ID=your-project-id
E2E_LOCATION=Delhi
E2E_NODE_ID=your-node-id

# Target MongoDB (checked with an unauthenticated isMaster command)
TARGET_IP=101.53.135.76
MONGO_PORT=27050
MONGO_TIMEOUT_MS=10000

# Reboot when MongoDB fails every check for MONGO_DOWN_DURATION_MS
CHECK_INTERVAL_MS=15000
ALERT_AFTER_MS=120000
MONGO_DOWN_DURATION_MS=210000
REBOOT_COOLDOWN_MS=1800000
MAX_REBOOTS_PER_DAY=3

# Keep true while testing. Set to false to allow real E2E reboots.
DRY_RUN=true

# SMTP (use an app password if applicable)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=alerts@example.com
SMTP_PASS=your-smtp-app-password
ALERT_FROM=alerts@example.com
ALERT_TO=oncall@example.com,ops@example.com
